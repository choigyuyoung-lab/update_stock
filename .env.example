# ==============================================================================
# [update_stock] 환경 변수 템플릿 (.env.example)
# 이 파일을 복사하여 .env 파일을 생성하고 실제 키 값을 입력하세요.
# GitHub Repository Secrets (Settings > Secrets and variables > Actions)에도
# 아래의 변수명 그대로 등록하시면 GitHub Actions 워크플로우가 정상 작동합니다.
# ==============================================================================

# 1. 노션(Notion) API 인증 토큰 (수집 대상 DB 전체 접근 권한 필요)
NOTION_TOKEN=ntn_your_notion_integration_token_here

# 2. 수집 및 동기화 대상 노션 데이터베이스 ID (32자리 Hex)
# [투자주 DB] 국내/미국 보유 및 관심 종목 시세/재무 갱신 대상 DB
DATABASE_ID=your_database_id_32_hex_chars

# [상장주식DB 전체] KRX 및 미국 전체 상장 종목 마스터 데이터베이스
MASTER_DATABASE_ID=your_master_database_id_32_hex_chars

# [지표지수 DB] S&P500, KOSPI, 나스닥, 금, 환율 등 벤치마크 지수 DB
BENCHMARK_DATABASE_ID=your_benchmark_database_id_32_hex_chars

# [ETF DB] 국내 상장 ETF 구성종목(PDF) 및 기본 정보 DB
ETF_DB_ID=your_etf_db_id_32_hex_chars

# 3. 한국투자증권(KIS) Open API 정보 (국내 시세/재무/ETF 수집용)
KIS_PAPER_TRADING=prod

# [기본 실전투자 API 키]
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here

# [실전투자 PROD 전용 별칭 (호환용)]
KIS_PROD_APP_KEY=your_kis_app_key_here
KIS_PROD_APP_SECRET=your_kis_app_secret_here

# [모의투자 VTS 전용 별칭 (선택사항)]
KIS_VTS_APP_KEY=your_kis_vts_app_key_here
KIS_VTS_APP_SECRET=your_kis_vts_app_secret_here
